# =====================================================================
# QA Project - Environment Configuration
# =====================================================================
# Any key configured here is automatically detected on startup.
# The UI modal will be bypassed automatically!
#
# Comma-separated keys will automatically round-robin load balance
# and failover if one key encounters rate limits (429) or high demand (503).
# =====================================================================

# 1. Groq (Default fast model: llama-3.3-70b-versatile)
# GROQ_API_KEY=gsk_key1,gsk_key2

# 2. OpenAI (Default model: gpt-4o-mini)
# OPENAI_API_KEY=sk-proj-key1,sk-proj-key2

# 3. Google Gemini (Default: gemini-flash-latest, auto-pins to latest Flash model; or use gemini-flash-lite-latest)
# GEMINI_API_KEY=AIzaSyKey1,AIzaSyKey2
# GEMINI_MODEL=gemini-flash-latest

# 4. Anthropic / Claude (Default model: claude-3-5-sonnet-20241022)
# ANTHROPIC_API_KEY=sk-ant-api03-key1,sk-ant-api03-key2
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 5. CodeVector Gateway (Default model: kimi-k-2-7-code)
# CODEVECTOR_API_KEY=your_codevector_token
# CODEVECTOR_GATEWAY=https://coding-gateway.fissionlabs.com/v1
# CODEVECTOR_MODEL=kimi-k-2-7-code
